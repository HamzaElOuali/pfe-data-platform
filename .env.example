# ══════════════════════════════════════════════════════════════
# PFE Data Platform — Variables d'environnement
# ══════════════════════════════════════════════════════════════

# ─── PostgreSQL Source (OLTP) ─────────────────────────────────
POSTGRES_SOURCE_HOST=postgres_source
POSTGRES_SOURCE_PORT=5432
POSTGRES_SOURCE_USER=admin
POSTGRES_SOURCE_PASSWORD=admin
POSTGRES_SOURCE_DB=oltp_db

# ─── MinIO (Object Storage — Bronze) ─────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# ─── Apache Airflow ──────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres_infra:5432/airflow
AIRFLOW__CORE__FERNET_KEY=FB1oq_F9_++Az1fUXY9W3_S6uW289H6_D5nUf__6H_8=
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# ─── Apache Beam ─────────────────────────────────────────────
BEAM_RUNNER=DirectRunner

# ─── FastAPI Mock ────────────────────────────────────────────
FASTAPI_MOCK_HOST=fastapi-mock
FASTAPI_MOCK_PORT=80

# ─── Grafana ─────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ─── DuckDB ──────────────────────────────────────────────────
DUCKDB_DATABASE_PATH=data/processed/warehouse.duckdb
